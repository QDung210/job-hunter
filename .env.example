# Copy this file to .env for local runs. In GitHub Actions, set these as
# repository secrets instead (Settings -> Secrets and variables -> Actions) —
# never commit a real .env file.

# Get this from @BotFather on Telegram after creating your bot with /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceThisWithYourOwn

# Your personal numeric chat id. Message your bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
# (or ask @userinfobot). Group chat ids are negative numbers, e.g. -1001234567890.
TELEGRAM_CHAT_ID=123456789
